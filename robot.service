[Unit]
Description=Disinfection Robot Dashboard
After=network.target

[Service]
User=gonxt
WorkingDirectory=/home/gonxt/evesix_code
ExecStart=/usr/bin/python3 -u /home/gonxt/evesix_code/dashboard.py
Restart=on-failure
RestartSec=5

# Force Python to flush stdout/stderr after every line so nothing is lost
# if the Pi is powered off before the buffer drains.
Environment=PYTHONUNBUFFERED=1

# Redirect all output to our log file
StandardOutput=append:/var/log/robot/robot.log
StandardError=append:/var/log/robot/robot.log

[Install]
WantedBy=multi-user.target
